			task.wait(0.2)
			if char then
				local bc = char.HumanoidRootPart and char.HumanoidRootPart:FindFirstChild("BodyClip")
				if bc then bc:Destroy() end
			end
			_G.StopTween = false
			_G.Clip = false
		end
		if char and char:FindFirstChild("Highlight") then
			char.Highlight:Destroy()
		end
	end

