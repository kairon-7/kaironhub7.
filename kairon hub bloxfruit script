    local tabs = {}

    local function createTab(name, icon)
        local btn = Instance.new("TextButton")
        local width = 85
        btn.Size = UDim2.new(0, width, 1, 0)
        btn.Position = UDim2.new(0, #tabs * (width + 5), 0, 0)
        btn.Text = icon .. " " .. name
        btn.TextColor3 = Color3.fromRGB(180, 180, 210)
        btn.TextSize = 12
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 45)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamSemibold
        btn.Parent = tabFrame

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn

        local content = Instance.new("ScrollingFrame")
        content.Size = UDim2.new(1, 0, 1, 0)
        content.BackgroundTransparency = 1
        content.BorderSizePixel = 0
        content.Visible = false
        content.Parent = contentFrame

        local tabData = {btn = btn, content = content}
        table.insert(tabs, tabData)

        btn.MouseButton1Click:Connect(function()
            for _, t in pairs(tabs) do
                t.content.Visible = false
                t.btn.BackgroundColor3 = Color3.fromRGB(25, 25, 45)
                t.btn.TextColor3 = Color3.fromRGB(180, 180, 210)
            end
            content.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(100, 60, 180)
            btn.TextColor3 = Color3.fromRGB(255, 200, 80)
        end)

        if #tabs == 1 then
            content.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(100, 60, 180)
            btn.TextColor3 = Color3.fromRGB(255, 200, 80)
        end

        return content
    end

    local function addButton(parent, text, callback, color)
        local btn = Instance.new("TextButton")
        local yPos = #parent:GetChildren() * 42 + 5
        btn.Size = UDim2.new(0, 190, 0, 35)
        btn.Position = UDim2.new(0.5, -95, 0, yPos)
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 14
        btn.BackgroundColor3 = color or Color3.fromRGB(50, 40, 90)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamSemibold
        btn.Parent = parent

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            pcall(callback)
        end)

        return btn
    end

    local function addToggle(parent, text, default, callback)
        local bg = Instance.new("Frame")
        local yPos = #parent:GetChildren() * 42 + 5
        bg.Size = UDim2.new(0, 190, 0, 35)
        bg.Position = UDim2.new(0.5, -95, 0, yPos)
        bg.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
        bg.BorderSizePixel = 0
        bg.Parent = parent

        local bgCorner = Instance.new("UICorner")
        bgCorner.CornerRadius = UDim.new(0, 6)
        bgCorner.Parent = bg

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.55, 0, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.Text = text
        label.TextColor3 = Color3.fromRGB(220, 220, 240)
        label.TextSize = 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamSemibold
        label.Parent = bg

        local tog = Instance.new("TextButton")
        tog.Size = UDim2.new(0, 45, 0, 25)
        tog.Position = UDim2.new(0.7, 0, 0.5, -12.5)
        tog.Text = default and "ON" or "OFF"
        tog.TextColor3 = Color3.fromRGB(255, 255, 255)
        tog.TextSize = 12
        tog.BackgroundColor3 = default and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(180, 0, 0)
        tog.BorderSizePixel = 0
        tog.Font = Enum.Font.GothamBold
        tog.Parent = bg

        local togCorner = Instance.new("UICorner")
        togCorner.CornerRadius = UDim.new(0, 5)
        togCorner.Parent = tog

        local state = default
        tog.MouseButton1Click:Connect(function()
            state = not state
            tog.Text = state and "ON" or "OFF"
            tog.BackgroundColor3 = state and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(180, 0, 0)
            pcall(callback, state)
        end)
        pcall(callback, default)
    end

    local playerTab = createTab("Player", "")
    local worldTab = createTab("World", "")
    local miscTab = createTab("Misc", "")

