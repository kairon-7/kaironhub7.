local function ValidateKey()
	local entered = KeyInput.Text:gsub("%s", "")
	if entered == VALID_KEY then
		StatusLbl.Text = "Key accepted! Loading..."
		StatusLbl.TextColor3 = Color3.fromRGB(80, 200, 100)
		Tween(SubmitBtn, { BackgroundColor3 = Color3.fromRGB(40, 160, 80) }, 0.2)
		Tween(KWin, { BackgroundTransparency = 1, Size = UDim2.new(0, 360, 0, 290) }, 0.4)
		task.delay(0.5, function()
			pcall(function() KeySG:Destroy() end)
			pcall(function() BG:Destroy() end)
			LoadMainHub()
		end)
	else
		StatusLbl.Text = "Invalid key. Join Discord to get yours."
		StatusLbl.TextColor3 = Color3.fromRGB(220, 60, 60)
		Tween(SubmitBtn, { BackgroundColor3 = Color3.fromRGB(160, 40, 40) }, 0.1)
		task.delay(0.2, function() Tween(SubmitBtn, { BackgroundColor3 = Color3.fromRGB(55, 55, 130) }, 0.2) end)
