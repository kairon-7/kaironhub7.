    coroutine.wrap(function()
        while true do
            wait(0.15)
            if autoFarm and player.Character then
                pcall(function()
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end

                    local nearest = nil
                    local shortest = 500

                    for _, v in pairs(Workspace:GetChildren()) do
                        if v:FindFirstChild("Humanoid") and v ~= player.Character then
                            local hum = v.Humanoid
                            if hum.Health and hum.Health > 0 then
                                local target = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("Head")
                                if target then
                                    local dist = (target.Position - hrp.Position).Magnitude
                                    if dist < shortest then
                                        shortest = dist
                                        nearest = v
                                    end
                                end
                            end
                        end
                    end

                    if nearest then
                        local target = nearest:FindFirstChild("HumanoidRootPart") or nearest:FindFirstChild("Torso") or nearest:FindFirstChild("Head")
                        if target then
                            hrp.CFrame = target.CFrame * CFrame.new(0, 0, 4)
                            wait(0.05)
                            VirtualUser:Button1Down(Vector2.new(0, 0))
                            wait(0.05)
                            VirtualUser:Button1Up(Vector2.new(0, 0))
                        end
                    end
                end)
            end
        end
    end)()

    coroutine.wrap(function()
        while true do
            wait(0.3)
            if autoCollect and player.Character then
                pcall(function()
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end

                    for _, v in pairs(Workspace:GetChildren()) do
                        if v:IsA("Part") or v:IsA("MeshPart") then
                            local name = v.Name:lower()
                            if string.find(name, "drop") or string.find(name, "collect") or string.find(name, "item") or string.find(name, "coin") then
                                if (v.Position - hrp.Position).Magnitude < 20 then
                                    hrp.CFrame = v.CFrame * CFrame.new(0, 1, 0)
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)()

    coroutine.wrap(function()
        while true do
            wait(1)
            if espEnabled then
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= player and plr.Character then
                        pcall(function()
                            if not plr.Character:FindFirstChild("ESP") then
                                local esp = Instance.new("BillboardGui")
                                esp.Name = "ESP"
                                esp.Size = UDim2.new(0, 80, 0, 20)
                                local head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
                                if head then
                                    esp.Adornee = head
                                    esp.Parent = plr.Character

                                    local label = Instance.new("TextLabel")
                                    label.Size = UDim2.new(1, 0, 1, 0)
                                    label.Text = plr.Name
                                    label.TextColor3 = Color3.fromRGB(255, 50, 50)
                                    label.TextScaled = true
                                    label.BackgroundTransparency = 1
                                    label.Font = Enum.Font.GothamBold
                                    label.Parent = esp
                                end
                            end
                        end)
                    end
                end
            end
        end
    end)()

    RunService.Heartbeat:Connect(function()
        if flyEnabled and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Velocity = Vector3.new(0, 0, 0)
