	local function Hop()
		local pid = game.PlaceId; local vis = {}
		while true do
			pcall(function()
				local d = game.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..pid.."/servers/Public?sortOrder=Asc&limit=100"))
				for _, s in pairs(d.data) do
					if tonumber(s.maxPlayers) > tonumber(s.playing) then
						local id = tostring(s.id); local dup = false
						for _, v in pairs(vis) do if v==id then dup=true end end
						if not dup then
							table.insert(vis, id)
							pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(pid, id, LP) end)
							task.wait(4)
						end
					end
				end
			end)
			task.wait(0.1)
		end
	end

