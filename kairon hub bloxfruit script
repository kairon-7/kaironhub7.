        if noclipEnabled and player.Character then
            for _, v in pairs(player.Character:GetChildren()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end)

    player.CharacterAdded:Connect(function(char)
        wait(0.5)
        if godMode then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
