local function unlockHub()
    statusLabel.Text = "Key Valid! Loading Hub..."
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    
    local success, err = pcall(function()
        loadstring(game:HttpGet(MAIN_SCRIPT_URL))()
    end)
    
    if success then
        screenGui:Destroy()
    else
        statusLabel.Text = "Failed to load hub! Error: " .. tostring(err)
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
end

local function wrongKey()
    statusLabel.Text = "Invalid Key! Get key from Discord"
    statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    
    keyBox.Position = UDim2.new(0, -5, 0, 68)
    game:GetService("TweenService"):Create(keyBox, TweenInfo.new(0.1), {Position = UDim2.new(0, 5, 0, 68)}):Play()
    game:GetService("TweenService"):Create(keyBox, TweenInfo.new(0.1), {Position = UDim2.new(0, -5, 0, 68)}):Play()
    game:GetService("TweenService"):Create(keyBox, TweenInfo.new(0.1), {Position = UDim2.new(0, 0, 0, 68)}):Play()
end

unlockBtn.MouseButton1Click:Connect(function()
    local inputKey = keyBox.Text:lower():gsub("%s+", "")
    
    if inputKey == "" then
        statusLabel.Text = "Please enter a key!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        return
    end
    
    if inputKey == CORRECT_KEY then
        unlockHub()
    else
        wrongKey()
    end
end)

keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        unlockBtn.MouseButton1Click:Fire()
    end
end)

keyBox:CaptureFocus()

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
        screenGui.Enabled = not screenGui.Enabled
    end
end)

