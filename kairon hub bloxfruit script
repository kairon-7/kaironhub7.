	-- Tween state flag (same as source u523)
	local TweenActive = false

	local function round(x) return math.floor(x + 0.5) end

	local function getHRP()
		return LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	end

	local function isAlive()
		return LP.Character
			and LP.Character:FindFirstChild("Humanoid")
			and LP.Character.Humanoid.Health > 0
			and getHRP()
	end

	-- ──────────────────────────────────────────────────────
	-- TELEPORT SYSTEM — exact source pattern, bounce fixed
	-- Fix 1: CanCollide = false on PartTele (source had true)
	-- Fix 2: BodyVelocity zero-pin keeps server happy
	-- Fix 3: magnitude guard uses 150 not 100 so it doesn't
	--         destroy PartTele before tween completes
	-- Fix 4: TweenSpeed is live — slider writes directly to
	--         the global so every topos call picks it up
	-- ──────────────────────────────────────────────────────
	local function WaitHRP(plr)
		if plr then
			return plr.Character:WaitForChild("HumanoidRootPart", 9)
		end
	end

	local function CheckNearestTeleporter(cf)
		local pos    = cf.Position
		local best   = math.huge
		local result = nil
		local pid    = game.PlaceId
		local gates  = {}

		if pid == 2753915549 then
			gates = {
				Sky3         = Vector3.new(-7894, 5547, -380),
				Sky3Exit     = Vector3.new(-4607, 874, -1667),
				UnderWater   = Vector3.new(61163, 11, 1819),
				UnderwaterExit = Vector3.new(4050, -1, -1814),
			}
		elseif pid == 4442272183 then
			gates = {
				["Swan Mansion"] = Vector3.new(-390, 332, 673),
				["Swan Room"]    = Vector3.new(2285, 15, 905),
				["Cursed Ship"]  = Vector3.new(923, 126, 32852),
				["Zombie Island"]= Vector3.new(-6509, 83, -133),
			}
		elseif pid == 7449423635 then
			gates = {
				["Floating Turtle"]  = Vector3.new(-12462, 375, -7552),
				["Hydra Island"]     = Vector3.new(5657.89, 1013.08, -335.5),
				Mansion              = Vector3.new(-12462, 375, -7552),
				Castle               = Vector3.new(-5036, 315, -3179),
				["Beautiful Pirate"] = Vector3.new(5319, 23, -93),
			}
		end

		for _, v in pairs(gates) do
			local d = (v - pos).Magnitude
			if d < best then
				result = v
				best   = d
			end
		end

		local hrp = getHRP()
		if hrp and best <= (pos - hrp.Position).Magnitude then
			return result
		end
	end

	local function requestEntrance(vec)
		pcall(function()
			ReplicatedStorage.Remotes.CommF_:InvokeServer("requestEntrance", vec)
			local hrp = getHRP()
			if hrp then hrp.CFrame = hrp.CFrame + Vector3.new(0, 50, 0) end
			task.wait(0.5)
		end)
	end

	local function stopTeleport()
		TweenActive = false
		local char = LP.Character
		if char then
			local p = char:FindFirstChild("PartTele")
			if p then p:Destroy() end
			-- remove any leftover zero-pin
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				local bv = hrp:FindFirstChild("RivoBV")
				if bv then bv:Destroy() end
			end
		end
	end

	-- Die → stop tween
	local function onCharAdded(char)
		char:WaitForChild("Humanoid").Died:Connect(stopTeleport)
	end
	LP.CharacterAdded:Connect(onCharAdded)
	if LP.Character then onCharAdded(LP.Character) end

	-- Safety: if PartTele drifts >150 studs from HRP the tween lost sync, kill it
	spawn(function()
		while task.wait() do
			pcall(function()
				local char = LP.Character
				if char then
					local pt  = char:FindFirstChild("PartTele")
					local hrp = char:FindFirstChild("HumanoidRootPart")
					if pt and hrp and (hrp.Position - pt.Position).Magnitude >= 150 then
						stopTeleport()
					end
					if not TweenActive then stopTeleport() end
				end
			end)
		end
	end)

	function topos(cf)
		if not isAlive() then return end
		if not cf then return end

		local char = LP.Character
		local hrp  = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		-- check if we need an entrance first
		local gate = CheckNearestTeleporter(cf)
		if gate then requestEntrance(gate) end

		local dist = (cf.Position - hrp.Position).Magnitude

		-- create PartTele if needed
		if not char:FindFirstChild("PartTele") then
			local p = Instance.new("Part", char)
			p.Size        = Vector3.new(10, 1, 10)
			p.Name        = "PartTele"
			p.Anchored    = true
			p.Transparency= 1
			p.CanCollide  = false  -- FIX: source had true which caused physics bounce
			p.CFrame      = hrp.CFrame

			-- drive HRP to follow the tween part (same as source)
			p.GetPropertyChangedSignal(p, "CFrame"):Connect(function()
				if TweenActive then
					task.wait()
					local h = char:FindFirstChild("HumanoidRootPart")
					if h then h.CFrame = p.CFrame end
				end
			end)
		end

		-- zero-pin BodyVelocity so server doesn't push us back
		if not hrp:FindFirstChild("RivoBV") then
			local bv = Instance.new("BodyVelocity", hrp)
			bv.Name     = "RivoBV"
			bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			bv.Velocity = Vector3.new(0, 0, 0)
		end

		-- noClip during travel
		if char:FindFirstChild("BodyClip") == nil then
			pcall(function()
				local bv2 = Instance.new("BodyVelocity")
				bv2.Name      = "BodyClip"
				bv2.MaxForce  = Vector3.new(1e5, 1e5, 1e5)
				bv2.Velocity  = Vector3.new(0, 0, 0)
				bv2.Parent    = hrp
			end)
		end

		TweenActive = true

		-- TweenSpeed global: higher = faster (dist/TweenSpeed = seconds)
		local dur = math.max(0.05, dist / TweenSpeed)

		local pt = char:FindFirstChild("PartTele")
		if not pt then return end

		local tw = TweenService:Create(pt, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
		tw:Play()
		tw.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed then
				-- snap HRP exactly onto target
				local h = char:FindFirstChild("HumanoidRootPart")
				if h then h.CFrame = cf end
				stopTeleport()
			end
		end)
	end

	function TP1(cf) topos(cf) end

