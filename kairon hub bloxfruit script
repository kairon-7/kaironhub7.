coroutine.wrap(function()
    while true do
        wait(0.15)
        if autoFarm and player.Character then
            pcall(function()
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local nearest = nil
                local shortest = 500
                
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v ~= player.Character then
                        local hum = v.Humanoid
                        if hum.Health and hum.Health > 0 then
                            local target = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("Head")
                            if target then
                                local dist = (target.Position - hrp.Position).Magnitude
                                if dist < shortest then
                                    shortest = dist
                                    nearest = v
                                end
                            end
                        end
                    end
                end
                
                if nearest then
                    local target = nearest:FindFirstChild("HumanoidRootPart") or nearest:FindFirstChild("Torso") or nearest:FindFirstChild("Head")
                    if target then
                        hrp.CFrame = target.CFrame * CFrame.new(0, 0, 4)
                        wait(0.05)
                        VirtualUser:Button1Down(Vector2.new(0, 0))
                        wait(0.05)
                        VirtualUser:Button1Up(Vector2.new(0, 0))
                    end
                end
            end)
        end
    end
end)()

coroutine.wrap(function()
    while true do
        wait(0.3)
        if autoCollect and player.Character then
            pcall(function()
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                for _, v in pairs(Workspace:GetChildren()) do
                    if v:IsA("Part") or v:IsA("MeshPart") then
                        local name = v.Name:lower()
                        if string.find(name, "drop") or string.find(name, "collect") or string.find(name, "item") or string.find(name, "coin") then
                            if (v.Position - hrp.Position).Magnitude < 20 then
                                hrp.CFrame = v.CFrame * CFrame.new(0, 1, 0)
                            end
                        end
                    end
                end
            end)
        end
    end
end)()

